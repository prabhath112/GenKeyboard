# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Comma-separated device ids exempt from the per-device cap (your own phones). Treat like a password.
UNLIMITED_DEVICE_IDS=
# Discord webhook for operator alerts (failures, parked models, daily summary). Empty = alerts off.
DISCORD_WEBHOOK_URL=
