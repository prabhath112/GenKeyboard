<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same set as backup_rules.xml: no learned-word dictionary. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="jetpref_datastore"/>
        <include domain="file" path="ime"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="jetpref_datastore"/>
        <include domain="file" path="ime"/>
    </device-transfer>
</data-extraction-rules>
