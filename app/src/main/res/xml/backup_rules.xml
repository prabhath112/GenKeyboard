<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. The learned-word dictionary is deliberately not backed up: it can contain
     names and passwords the user typed. -->
<full-backup-content>
    <include
        domain="root"
        path="jetpref_datastore"/>
    <include
        domain="file"
        path="ime"/>
</full-backup-content>
